  "components": [
    {
      "id": "rules-engine",
      "explanation": "game/rules.gd is the whole rule set as plain data: board 8 x 5, units, orders in, a list of events out (moved, attack, damaged, killed, attack_cancelled), deterministic, no nodes and no audio. The attack loop alternates sides one unit at a time, the side that strikes first switches each turn (first_side), and a unit killed before its turn does not attack. Shown in B12; its consequence (the naive plan loses on turn 4) in B13.",
      "beat_ids": [
        "B12",
        "B13"
      ],
      "files": [
        "game/rules.gd"
      ]
    },
    {
      "id": "scene-controller",
      "explanation": "game/main.gd asks Rules for the result first, then plays the returned events back once on its own clock (hop, draw, arrow, impact, cards) and calls AudioDirector at the moment each event is shown; it draws the board, HUD, markers and arrow in code through draw_layer.gd. main.tscn holds Main + AudioDirector; project.godot sets the 1280 x 720 canvas_items viewport. Seen running in B03 and cited in B15 (main.gd lines 411 and 507).",
      "beat_ids": [
        "B03",
        "B15"
      ],
      "files": [
        "game/main.gd",
        "game/main.tscn",
        "game/draw_layer.gd",
        "project.godot"
      ]
    },
    {
      "id": "piece-display",
      "explanation": "game/piece.gd swaps one static generated texture per state (idle, draw, hurt, defeat, win), scales every pose with the idle image's scale, flips the enemy with flip_h and positions the sprite from the base disc. The ten archer PNGs (player + recoloured enemy) and their import sidecars are the generated, edited character art traced in B04-B09.",
      "beat_ids": [
        "B07",
        "B09",
        "B10",
        "B11"
      ],
