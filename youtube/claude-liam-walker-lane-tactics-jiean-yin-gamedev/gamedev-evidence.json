  "excerpts": [
    {
      "beat_id": "B10",
      "path": "game/piece.gd",
      "start_line": 175,
      "end_line": 185,
      "text": "\t# One scale for every pose, taken from the idle image, so all states share the same pixel size.\n\tvar ref: Texture2D = _find_texture(\"idle\")[0]\n\tif ref == null:\n\t\tref = tex\n\tvar s: float = TARGET_HEIGHT / maxf(1.0, float(ref.get_height()))\n\t_sprite.texture = tex\n\t_sprite.visible = true\n\t_sprite.modulate = found[2]\n\t_sprite.scale = Vector2(s, s)\n\t_sprite.flip_h = facing < 0\n\t_sprite.position = Vector2(0.0, -tex.get_height() * s * 0.5 + BASE_FROM_BOTTOM - _lift)"
    },
    {
      "beat_id": "B12",
      "path": "game/rules.gd",
      "start_line": 341,
      "end_line": 346,
      "text": "\tfor id: String in attack_order(targets):\n\t\tvar u: Dictionary = get_unit(id)\n\t\tif int(u[\"hp\"]) <= 0:\n\t\t\tcontinue # killed before its turn: no attack\n\t\tif not targets.has(id):\n\t\t\tcontinue"
    },
    {
      "beat_id": "B15",
      "path": "game/audio_director.gd",
      "start_line": 105,
      "end_line": 118,
      "text": "\tmatch String(ev.get(\"type\", \"\")):\n\t\t\"moved\":\n\t\t\t_trigger(\"SFX-HOP\", ev)\n\t\t\"damaged\":\n\t\t\tvar key: String = String(ev.get(\"attack\", \"\"))\n\t\t\tif _sounded_attacks.has(key):\n\t\t\t\tguarded_skips += 1\n\t\t\t\treturn\n\t\t\tif ev[\"team\"] == PLAYER:\n\t\t\t\t_sounded_attacks[key] = true\n\t\t\t\t_trigger(\"SFX-HURT\", ev)\n\t\t\telif ev[\"team\"] == ENEMY and ev.get(\"by_team\", \"\") == PLAYER:\n\t\t\t\t_sounded_attacks[key] = true\n\t\t\t\t_trigger(\"SFX-HIT\", ev)"
    }
  ],
