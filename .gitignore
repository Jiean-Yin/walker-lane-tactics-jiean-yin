# Engine caches and local editor state
.godot/
*.import.tmp
.DS_Store
.idea/
.vscode/

# Raw downloads (MP3/MP4/WAV/full-size rejects) stay out of git; game audio ships as OGG.
assets/_raw/
*.[mM][pP]3
*.[mM][pP]4
*.avi
*.mov
*.wav
exports/
builds/

# Blender's automatic older-save backups (.blend1, .blend2, ...); the .blend source itself is committed
*.blend[0-9]*

# Local credentials/configuration
.env
.env.*
!.env.example
credentials/
*.p12
*.pfx

# Git cannot ignore by size: inspect staged files before committing (>25 MB).
