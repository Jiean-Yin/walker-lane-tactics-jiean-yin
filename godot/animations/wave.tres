[gd_resource type="Animation" format=3]

; wave: the goal flag's cycle (CHANGE-BRIEF.md §2-3).
; 4 frames at 8 fps: step 0.125, length 0.5 (4 key intervals), LOOP_LINEAR.
; Seam rule: no key at length; the last frame key is 3, one interval before length.
; Track 1 keys the sheet cell; track 2 is the accepted registration fix, keying offset.x
; (source px) = 0, -4, -2, +1 on the same times so the pole stays at x = 4 in every cell.

[resource]
resource_name = "wave"
length = 0.5
loop_mode = 1
step = 0.125
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("FlagSprite:frame")
tracks/0/interp = 0
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0, 0.125, 0.25, 0.375),
"transitions": PackedFloat32Array(1, 1, 1, 1),
"update": 1,
"values": [0, 1, 2, 3]
}
tracks/1/type = "value"
tracks/1/imported = false
tracks/1/enabled = true
tracks/1/path = NodePath("FlagSprite:offset")
tracks/1/interp = 0
tracks/1/loop_wrap = true
tracks/1/keys = {
"times": PackedFloat32Array(0, 0.125, 0.25, 0.375),
"transitions": PackedFloat32Array(1, 1, 1, 1),
"update": 1,
"values": [Vector2(0, 0), Vector2(-4, 0), Vector2(-2, 0), Vector2(1, 0)]
}
